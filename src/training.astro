---
import Layout from '../layouts/Layout.astro';
import TrainingContent from '../components/site/pages/TrainingContent.jsx';
import { getEntry } from 'astro:content';
import { getSettings, getPageContent } from '../lib/content';

const teachers = (await getEntry('teachers', 'teachers'))?.data.teachers || [];
const jakob = teachers.find(t => t.slug === 'jakob');
const settings = await getSettings();
const content = await getPageContent('trainingPage', 'training', settings);
---
<Layout active="training" title="Training">
  <TrainingContent client:load jakobImage={jakob?.image} content={content} settings={settings} />
</Layout>
