---
import Layout from '../layouts/Layout.astro';
import VoicesContent from '../components/site/pages/VoicesContent.jsx';
import { getCollection } from 'astro:content';
import { getSettings, getPageContent } from '../lib/content';

const testimonials = (await getCollection('testimonials'))
  .sort((a, b) => a.data.order - b.data.order)
  .map(t => ({ id: t.id, ...t.data }));
const settings = await getSettings();
const page = await getPageContent('voicesPage', 'voices', settings);
---
<Layout active="voices" title={page?.title || 'Stimmen'}>
  <VoicesContent client:load voices={testimonials} settings={settings} page={page} />
</Layout>
