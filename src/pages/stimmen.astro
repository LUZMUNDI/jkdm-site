---
import Layout from '../layouts/Layout.astro';
import VoicesContent from '../components/site/pages/VoicesContent.jsx';
import { getCollection, getEntry } from 'astro:content';

const testimonials = (await getCollection('testimonials'))
  .sort((a, b) => a.data.order - b.data.order)
  .map(t => ({ id: t.id, ...t.data }));
const settings = (await getEntry('settings', 'global'))?.data;
---
<Layout active="voices" title="Stimmen">
  <VoicesContent client:load voices={testimonials} settings={settings} />
</Layout>
