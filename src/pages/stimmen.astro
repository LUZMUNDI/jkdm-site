---
import Layout from '../layouts/Layout.astro';
import VoicesContent from '../components/site/pages/VoicesContent.jsx';
import { getEntry } from 'astro:content';
import { getSettings, getPageContent } from '../lib/content';

const voices = ((await getEntry('students', 'students'))?.data.students || [])
  .map(s => ({ id: s.slug, ...s }));
const settings = await getSettings();
const page = await getPageContent('voicesPage', 'voices', settings);
---
<Layout active="voices" title={page?.title || 'Stimmen'}>
  <VoicesContent client:load voices={voices} settings={settings} page={page} />
</Layout>
