---
import Layout from '../layouts/Layout.astro';
import LegalContent from '../components/site/pages/LegalContent.jsx';
import { getEntry } from 'astro:content';

const page = (await getEntry('datenschutzPage', 'datenschutz'))?.data;
---
<Layout active="" title={page?.title || 'Datenschutz'}>
  <LegalContent client:load page={page} />
</Layout>
