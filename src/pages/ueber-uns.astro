---
import Layout from '../layouts/Layout.astro';
import AboutContent from '../components/site/pages/AboutContent.jsx';
import { getCollection, getEntry } from 'astro:content';

const instructors = (await getCollection('instructors'))
  .sort((a, b) => a.data.order - b.data.order)
  .map(i => ({ id: i.id, ...i.data }));
const settings = (await getEntry('settings', 'global'))?.data;
---
<Layout active="about" title="Über uns">
  <AboutContent client:load roster={instructors} settings={settings} />
</Layout>
