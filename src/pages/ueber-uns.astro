---
import Layout from '../layouts/Layout.astro';
import AboutContent from '../components/site/pages/AboutContent.jsx';
import { getEntry } from 'astro:content';
import { getSettings, getPageContent } from '../lib/content';

const roster = ((await getEntry('teachers', 'teachers'))?.data.teachers || [])
  .map(t => ({ id: t.slug, ...t }));
const settings = await getSettings();
const page = await getPageContent('aboutPage', 'about', settings);
---
<Layout active="about" title={page?.title || 'Über uns'}>
  <AboutContent client:load roster={roster} settings={settings} page={page} />
</Layout>
