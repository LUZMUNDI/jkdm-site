---
import Layout from '../layouts/Layout.astro';
import SeminarsContent from '../components/site/pages/SeminarsContent.jsx';
import { getCollection } from 'astro:content';
import { getSettings, getPageContent } from '../lib/content';

const seminars = (await getCollection('seminars'))
  .sort((a, b) => a.data.order - b.data.order)
  .map(s => ({ id: s.id, ...s.data }));
const settings = await getSettings();
const page = await getPageContent('seminarsPage', 'seminars', settings);
---
<Layout active="seminars" title={page?.title || 'Seminare'}>
  <SeminarsContent client:load seminars={seminars} settings={settings} page={page} />
</Layout>
