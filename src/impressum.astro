---
import Layout from '../layouts/Layout.astro';
import LegalContent from '../components/site/pages/LegalContent.jsx';
import { getEntry } from 'astro:content';

const page = (await getEntry('impressumPage', 'impressum'))?.data;
---
<Layout active="" title={page?.title || 'Impressum'}>
  <LegalContent client:load page={page} />
</Layout>
