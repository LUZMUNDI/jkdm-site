---
import '../styles/global.css';
import SiteHeader from '../components/site/SiteHeader.jsx';
import { SiteFooter } from '../components/site/Shared.jsx';
import { getEntry } from 'astro:content';

interface Props {
  active: string;
  title: string;
  description?: string;
}
const { active, title, description = "JKDM — Jeet Kune Do München. Privates Studio, gegründet 2017 von Sifu Dominik Rettig." } = Astro.props;

const settingsEntry = await getEntry('settings', 'global');
const settings = settingsEntry?.data;
---
<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title} · JKDM — Jeet Kune Do München</title>
  </head>
  <body>
    <SiteHeader client:load active={active} />
    <main>
      <slot />
    </main>
    <SiteFooter settings={settings} />
  </body>
</html>
